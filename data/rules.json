{
  "map": {
    "width": 15,
    "height": 15,
    "land_fraction": 0.70,
    "growth_center_bias": 1.5,
    "growth_noise_min": 0.3,
    "levels": 3,
    "hill_center_jitter": 1,
    "hill_level_fractions_from_top": [0.12, 0.30],
    "hill_noise": 1.5
  },

  "economy": {
    "start_money": 260,
    "start_fuel": 3,
    "income_from_round": 2,
    "baseline_money": 30,
    "baseline_fuel": 3,
    "baseline_research": 0
  },

  "bases": {
    "per_side": 3,
    "strongholds_per_side": 0,
    "_note_strongholds": "How many of each side's bases are strongholds (set by the level, data/levels.json). The first bases placed are the strongholds.",
    "no_adjacent_bases_or_decoys": true
  },

  "buildings": {
    "base":               { "role": "base",     "cost": 0,  "hits_to_destroy": 2, "buildable": false, "repairable": false },
    "stronghold":         { "role": "base",     "cost": 0,  "buildable": false, "missile_proof": true, "anti_air_mount": true, "repair_cost": 15 },
    "decoy":              { "role": "decoy",    "cost": 20, "hits_to_destroy": 1, "repairable": false },
    "bank":               { "role": "economy",  "cost": 50, "hp": 40, "produces": { "money": 15 }, "upgrade": { "research": "bank_upgrade", "produces": { "money": 25 } } },
    "refinery":           { "role": "economy",  "cost": 50, "hp": 40, "produces": { "fuel": 3 }, "upgrade": { "research": "refinery_upgrade", "produces": { "fuel": 6 } } },
    "lab":                { "role": "lab",      "cost": 60, "hp": 40, "produces": { "research": 2 } },
    "basic_launcher":     { "role": "launcher", "cost": 60, "hp": 50, "weapon": true, "missiles": ["basic", "scouting"] },
    "anti_air":           { "role": "anti_air", "cost": 40, "hp": 50, "weapon": true },
    "radar":              { "role": "radar",    "cost": 50, "hp": 30, "requires": "radar" },
    "ballistic_launcher": { "role": "launcher", "cost": 90, "hp": 50, "weapon": true, "missiles": ["ballistic"], "requires": "ballistic_launcher" },
    "airport":            { "role": "airport",  "cost": 100, "hp": 60, "weapon": true, "missiles": ["transport", "spy"], "requires": "airport" },
    "bunker":             { "role": "bunker",   "cost": 50, "hp": 80, "weapon": true, "requires": "bunker" },
    "docks":              { "role": "docks",    "cost": 80, "hp": 60, "weapon": true, "missiles": ["boat"], "requires": "docks", "coastal": true },
    "coastal_cannon":     { "role": "coastal_cannon", "cost": 60, "hp": 60, "weapon": true, "requires": "coastal_cannon", "coastal": true },
    "nuclear_silo":       { "role": "silo",     "cost": 120, "hp": 80, "weapon": true, "missiles": ["nuke"], "requires": "nuclear_silo" }
  },
  "_note_upgrade": "upgrade: once its research is done, the building produces these amounts instead.",

  "missiles": {
    "basic":     { "fuel": 3, "damage_min": 30, "damage_max": 50, "blast_radius": 0, "view_radius": 1, "base_hits": 1.0, "seeks_with": "motion_sensor" },
    "scouting":  { "fuel": 1, "damage_min": 0,  "damage_max": 0,  "blast_radius": -1, "view_radius": 2, "base_hits": 0.0, "requires": "scouting_missile" },
    "ballistic": { "fuel": 5, "damage_min": 15, "damage_max": 25, "blast_radius": 1, "view_radius": 1, "base_hits": 0.5 },
    "transport": { "fuel": 6, "money": 40, "replace_money": 40, "damage_min": 0, "damage_max": 0, "blast_radius": -1, "view_radius": 0, "base_hits": 0.0, "carries": "platoon" },
    "boat":      { "fuel": 4, "money": 30, "replace_money": 30, "damage_min": 0, "damage_max": 0, "blast_radius": -1, "view_radius": 0, "base_hits": 0.0, "carries": "platoon", "crossing_rounds": 0, "lands_on_coast": true },
    "nuke":      { "fuel": 10, "replace_money": 120, "build_rounds": 1, "spent_on_launch": true, "launch_reveals_launcher": true, "damage_min": 30, "damage_max": 50, "blast_radius": 1, "centre_factor": 2.0, "blast_crosses_height_step": true, "view_radius": 1, "base_hits": 1.0, "breaks_strongholds": true, "anti_air_accuracy": 0.05, "anti_air_accuracy_with_radar": 0.20 },
    "spy":       { "fuel": 2, "money": 60, "damage_min": 0, "damage_max": 0, "blast_radius": -1, "view_radius": 0, "base_hits": 0.0, "requires": "spy", "walks": 3, "max_on_ground": 1, "own_aircraft": true, "anti_air_accuracy": 0.225, "anti_air_accuracy_with_radar": 0.45 }
  },
  "_note_spy": "The spy: sent from an airport instead of its transport (one order per airport a round), in his own helicopter, so a lost transport doesn't keep him home (own_aircraft). money is paid at each launch. Anti-air engages him as a missile but hits half as often (his own anti-air accuracies); shot down, the trip and its money are lost. If he lands on land he stays on the enemy island and uncovers walks contiguous hexes a round (the landing hex is the first of them in the landing round): each step heads for the nearest hex his side has never seen (else the one seen longest ago), keeping out of the reach of radars and bunkers his side knows of. Where an enemy radar (its range) or active bunker (troops.bunker_range) reaches the hex he stands on, he is caught; the hexes he uncovered and what caught him are revealed. Landing on the sea loses him. A side may have max_on_ground spies on the enemy island at once.",
  "_note_nuke": "The nuke: launch_reveals_launcher: firing it reveals its silo to the other side, whether or not it gets through. a silo holds one at a time. A new silo is empty; building a nuke costs replace_money and takes build_rounds rounds, then it can be fired (fuel). It is used up when fired, shot down or not. Every hex of the blast takes a basic missile's damage (base_hits on a base or decoy); the centre hex takes centre_factor times that. It ignores the height-step rule for blasts, and has its own anti-air accuracies. breaks_strongholds: a stronghold that takes 2 or more hits from it in one round falls (other missiles only knock out its gun).",

  "troops": {
    "platoon_march": 2,
    "platoon_can_climb": false,
    "bunker_range": 2,
    "cannon_range": 3,
    "cannon_accuracy": 0.5
  },

  "research": {
    "radar":              { "cost": 30, "points": 6,  "tab": "buildings" },
    "ballistic_launcher": { "cost": 60, "points": 14, "tab": "buildings" },
    "airport":            { "cost": 80, "points": 18, "tab": "buildings" },
    "bunker":             { "cost": 40, "points": 10, "tab": "buildings" },
    "docks":              { "cost": 50, "points": 12, "tab": "buildings" },
    "coastal_cannon":     { "cost": 40, "points": 10, "tab": "buildings" },
    "scouting_missile":   { "cost": 20, "points": 4,  "tab": "upgrades" },
    "anti_air_capacity":  { "cost": 20, "points": 4,  "tab": "upgrades" },
    "motion_sensor":      { "cost": 50, "points": 12, "tab": "upgrades" },
    "nuclear_silo":       { "cost": 100, "points": 20, "tab": "buildings", "available": false, "needs_researched": 4, "start_researched": false },
    "bank_upgrade":       { "cost": 60, "points": 12, "tab": "upgrades", "available": false, "start_researched": false },
    "spy":                { "cost": 60, "points": 12, "tab": "upgrades", "available": false, "start_researched": false, "needs": "airport" },
    "refinery_upgrade":   { "cost": 60, "points": 12, "tab": "upgrades", "available": false, "start_researched": false }
  },
  "_note_research": "available: false hides an item until a level turns it on (data/levels.json). needs_researched: how many other items must be done before it can be started. needs: one item that must be done first. start_researched: both sides start the match with it done (a level sets it for what earlier levels brought in).",

  "anti_air": {
    "radius": 3,
    "engagements": 2,
    "engagements_upgraded": 3,
    "capacity_research": "anti_air_capacity",
    "accuracy": 0.45,
    "accuracy_with_radar": 0.90
  },

  "radar": {
    "range_by_level": [2, 3, 4]
  },

  "motion_sensor": {
    "seek_range": 3
  },

  "elevation": {
    "impact_reveals_uphill": false,
    "blast_crosses_height_step": false,
    "seek_can_change_level": false,
    "ocean_level": 0
  },

  "damage": {
    "half_strength_when_damaged": true,
    "repair_takes_building_out": true,
    "half_strength_income_rounding": "up",
    "radar_half_range_min": 1,
    "repair_cost_fraction": 0.30
  }
}
